# SERVEUR
PORT=8585
APP_BASE_URL=https://darkclaude.online
PUBLIC_DIR=../public
FX_EUR_HTG=150
LIFETIME_EUR=69
MAX_MESSAGE_CHARS=4000

# OPENROUTER (clé régénérée, jamais committée)
OPENROUTER_API_KEY=
MODEL_FREE=openrouter/free
MODEL_STANDARD=cognitivecomputations/dolphin-mistral-24b-venice-edition
MODEL_PREMIUM=cognitivecomputations/dolphin3.0-r1-mistral-24b
MODEL_VISION=qwen/qwen3.8-27b:free

# RECHERCHE WEB (Tavily, clé en tvly-…)
SEARCH_API_KEY=

# BASES
DATABASE_URL=postgresql://user:password@localhost:5432/darkclaude_db
REDIS_URL=redis://127.0.0.1:6379

# PAIEMENT MANUEL (HTG)
ENABLE_MANUAL_ACTIVATION=true
PAY_NATCASH_NUMBER=
PAY_MONCASH_NUMBER=
ADMIN_EMAILS=toi@exemple.com
SESSION_TTL_DAYS=30
